{
  "AllowedHosts": "*",

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "ConnectionStrings": {
    "SSO": "",
    "Core": "",
    "ServiceBus": ""
  },

  "Eventing": {
    "ProviderType": "Http",
    "Http": {
      "MaxConcurrency": 1
    },
    "ServiceBus": {
      "MaxConcurrency": 1
    }
  },

  "Settings": {
    "AggregateDomains": false,
    "CacheSourceAppId": 1,
    "CacheSource": "/",
    "CacheExpiry": 30,
    "DecryptionKey": "",
    "SessionTimeout": 20
  },

  "Services": {
    "Workflow": "https://localhost:7100/api/",
    "HostedServices": "https://localhost:7100/"
  },

  "AppSecurity": {
    "RootPath": "Api/AppSecurity"
  },

  "ContentManagement": {
    "RootPath": "Api/ContentManagement"
  },

  "DocumentManagement": {
    "RootPath": "Api/DocumentManagement"
  },

  "DomainLogging": {
    "RootPath": "Api/Logging"
  },

  "Mail": {
    "RootPath": "Api/Mail"
  },

  "Workflow": {
    "RootPath": "Api/Workflow"
  }
}
