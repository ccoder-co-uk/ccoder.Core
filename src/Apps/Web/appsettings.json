{
  "AllowedHosts": "*",

  "AI": {
    "DefaultProvider": "Ollama",
    "Agent": {
      "MaxIterations": 6,
      "ShellCommandTimeoutSeconds": 30,
      "StreamingChunkCharacterCount": 18,
      "StreamingChunkDelayMilliseconds": 20
    },
    "Providers": {
      "Ollama": {
        "Name": "Ollama",
        "CompletionProvider": {
          "Mode": "OllamaApi",
          "Endpoint": "http://localhost:11434/api/chat",
          "DefaultModel": "gpt-oss:20b",
          "ApiKey": "",
          "TimeoutSeconds": 120,
          "Temperature": 0.2
        },
        "ModelProvider": {
          "Mode": "OllamaApi",
          "Endpoint": "http://localhost:11434",
          "ApiKey": "",
          "TimeoutSeconds": 120
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "ConnectionString": "",
    "DebugInfo": false,
    "LogSQL": false,
    "StoreLogEntries": true,
    "StreamLogEntries": true,
    "RetentionDays": 30,
    "RetentionIntervalMinutes": 60,
    "DefaultAppId": 1,
    "DefaultAppDomain": "",
    "RootPath": "Api/Logging"
  },

  "AppSecurity": {
      "ConnectionString": "",
      "AggregateDomains": false,
      "DebugInfo": false,
      "LogSQL": false,
      "RootPath": "Api/AppSecurity",
      "IncludeLegacyCoreContext": false,
      "IsMigrating": false
    },

  "Security": {
      "ConnectionString": "",
      "DecryptionKey": "",
      "RootPath": "Api/Security",
      "IsMigrating": false
    },

  "ContentManagement": {
      "ConnectionString": "",
      "CacheSource": "/",
      "CacheSourceAppId": 1,
      "CacheExpiry": 30,
      "SslPort": null,
      "WorkflowServiceUrl": "https://localhost:7100/api/",
      "DebugInfo": false,
      "LogSQL": false,
      "RootPath": "Api/ContentManagement",
      "IncludeLegacyCoreContext": false
    },

  "DocumentManagement": {
      "ConnectionString": "",
      "SslPort": null,
      "DebugInfo": false,
      "LogSQL": false,
      "RootPath": "Api/DocumentManagement",
      "IncludeLegacyCoreContext": false
    },

  "Mail": {
    "ConnectionString": "",
    "DebugInfo": false,
    "LogSQL": false,
    "RootPath": "Api/Mail",
    "IsMigrating": false,
    "Providers": [
      {
        "Name": "Smtp"
      },
      {
        "Name": "Pop3"
      },
      {
        "Name": "Imap"
      },
      {
        "Name": "MicrosoftGraph",
        "MicrosoftGraph": {
          "TenantId": "",
          "ClientId": "",
          "ClientSecret": "",
          "GraphBaseUrl": "https://graph.microsoft.com/v1.0",
          "LoginBaseUrl": "https://login.microsoftonline.com"
        }
      }
    ]
  },

  "Packaging": {
    "ConnectionString": "",
    "AssetsRoot": "https://raw.githubusercontent.com/ccoder-co-uk/cCoder.Assets/main/Packages/"
  },

  "Workflow": {
      "ConnectionString": "",
      "ServiceUrl": "https://localhost:7100/",
      "SslPort": 443,
      "QueueInstanceManagement": {
        "PollingIntervalMilliseconds": 60000
      },
      "DebugInfo": false,
      "LogSQL": false,
      "RootPath": "Api/Workflow",
      "IncludeLegacyCoreContext": false,
      "IsMigrating": false
    },

    "Eventing": {
      "ProviderType": "Http",
      "Http": {
        "HubUrl": "",
        "MaxConcurrency": 1
      },
      "ServiceBus": {
        "ConnectionString": "",
        "MaxConcurrency": 1
      }
    }
}
