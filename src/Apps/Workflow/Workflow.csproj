<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LocalWorkflowActivitiesProject Condition="'$(LocalWorkflowActivitiesProject)' == ''">..\..\..\..\cCoder.Workflow\src\cCoder.Workflow.Activities\cCoder.Workflow.Activities.csproj</LocalWorkflowActivitiesProject>
    <LocalWorkflowEngineProject Condition="'$(LocalWorkflowEngineProject)' == ''">..\..\..\..\cCoder.Workflow\src\cCoder.Workflow.Engine\cCoder.Workflow.Engine.csproj</LocalWorkflowEngineProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="cCoder.Data" Version="2026.11.23.1635" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="cCoder.Workflow.Activities" Version="2026.11.26.1458" Condition="'$(UseLocalWorkflow)' != 'true'" />
    <PackageReference Include="cCoder.Workflow.Engine" Version="2026.11.26.1458" Condition="'$(UseLocalWorkflow)' != 'true'" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.15" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalWorkflow)' == 'true'">
    <ProjectReference Include="$(LocalWorkflowActivitiesProject)" />
    <ProjectReference Include="$(LocalWorkflowEngineProject)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Update="cCoder.CodeAnalysis" Version="2026.11.20.1604" />
  </ItemGroup>
</Project>
