<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <LocalAIProject>..\..\..\cCoder.AI\src\cCoder.AI\cCoder.AI.csproj</LocalAIProject>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <NoWarn>1591;STX0001</NoWarn>
    <Features>experimental-data-section-string-literals</Features>
  </PropertyGroup>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>cCoder;Core;cCoder.Core</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PrivateRepositoryUrl>https://github.com/ccoder-co-uk/cCoder.Core.git</PrivateRepositoryUrl>
    <ProjectUrl>https://github.com/ccoder-co-uk/cCoder.Core</ProjectUrl>
    <RepositoryUrl>https://github.com/ccoder-co-uk/cCoder.Core.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Description>cCoder.Core</Description>
    <Copyright>2026 Paul Ward</Copyright>
    <Authors>cCoder</Authors>
    <PackageId>cCoder.Core</PackageId>
  </PropertyGroup>
  <PropertyGroup>
    <LocalAppSecurityProject>..\..\..\cCoder.AppSecurity\src\cCoder.AppSecurity\cCoder.AppSecurity.csproj</LocalAppSecurityProject>
    <LocalContentManagementProject>..\..\..\cCoder.ContentManagement\src\cCoder.ContentManagement\cCoder.ContentManagement.csproj</LocalContentManagementProject>
    <LocalDataProject>..\..\..\cCoder.Data\src\cCoder.Data\cCoder.Data.csproj</LocalDataProject>
    <LocalDocumentManagementProject>..\..\..\cCoder.DocumentManagement\src\cCoder.DocumentManagement\cCoder.DocumentManagement.csproj</LocalDocumentManagementProject>
    <LocalEventingProject>..\..\..\ccoder.Eventing\src\cCoder.Eventing\cCoder.Eventing.csproj</LocalEventingProject>
    <LocalEventingHttpProject>..\..\..\ccoder.Eventing\src\cCoder.Eventing.Http\cCoder.Eventing.Http.csproj</LocalEventingHttpProject>
    <LocalEventingAzureServiceBusProject>..\..\..\ccoder.Eventing\src\cCoder.Eventing.AzureServiceBus\cCoder.Eventing.AzureServiceBus.csproj</LocalEventingAzureServiceBusProject>
    <LocalLoggingProject>..\..\..\cCoder.Logging\src\cCoder.Logging\cCoder.Logging.csproj</LocalLoggingProject>
    <LocalMailProject>..\..\..\cCoder.Mail\src\cCoder.Mail\cCoder.Mail.csproj</LocalMailProject>
    <LocalPackagingProject>..\..\..\cCoder.Packaging\src\cCoder.Packaging\cCoder.Packaging.csproj</LocalPackagingProject>
    <LocalSecurityProject>..\..\..\cCoder.Security\src\cCoder.Security\cCoder.Security.csproj</LocalSecurityProject>
    <LocalSecurityDataProject>..\..\..\cCoder.Security\src\cCoder.Security.Data\cCoder.Security.Data.csproj</LocalSecurityDataProject>
    <LocalWorkflowProject>..\..\..\cCoder.Workflow\src\cCoder.Workflow\cCoder.Workflow.csproj</LocalWorkflowProject>
    <LocalWorkflowActivitiesProject>..\..\..\cCoder.Workflow\src\cCoder.Workflow.Activities\cCoder.Workflow.Activities.csproj</LocalWorkflowActivitiesProject>
    <LocalWorkflowEngineProject>..\..\..\cCoder.Workflow\src\cCoder.Workflow.Engine\cCoder.Workflow.Engine.csproj</LocalWorkflowEngineProject>
    <UseLocalAppSecurity Condition="'$(UseLocalAppSecurity)' == ''">false</UseLocalAppSecurity>
    <UseLocalAI Condition="'$(UseLocalAI)' == ''">false</UseLocalAI>
    <UseLocalData Condition="'$(UseLocalData)' == ''">false</UseLocalData>
    <UseLocalContentManagement Condition="'$(UseLocalContentManagement)' == ''">false</UseLocalContentManagement>
    <UseLocalDocumentManagement Condition="'$(UseLocalDocumentManagement)' == ''">false</UseLocalDocumentManagement>
    <UseLocalEventing Condition="'$(UseLocalEventing)' == ''">false</UseLocalEventing>
    <UseLocalLogging Condition="'$(UseLocalLogging)' == ''">false</UseLocalLogging>
    <UseLocalMail Condition="'$(UseLocalMail)' == ''">false</UseLocalMail>
    <UseLocalPackaging Condition="'$(UseLocalPackaging)' == ''">false</UseLocalPackaging>
    <UseLocalSecurity Condition="'$(UseLocalSecurity)' == ''">false</UseLocalSecurity>
    <UseLocalWorkflow Condition="'$(UseLocalWorkflow)' == ''">false</UseLocalWorkflow>
    <UseLocalAppSecurity Condition="'$(UseLocalAppSecurity)' == 'true' and !Exists('$(LocalAppSecurityProject)')">false</UseLocalAppSecurity>
    <UseLocalAI Condition="'$(UseLocalAI)' == 'true' and !Exists('$(LocalAIProject)')">false</UseLocalAI>
    <UseLocalData Condition="'$(UseLocalData)' == 'true' and !Exists('$(LocalDataProject)')">false</UseLocalData>
    <UseLocalContentManagement Condition="'$(UseLocalContentManagement)' == 'true' and !Exists('$(LocalContentManagementProject)')">false</UseLocalContentManagement>
    <UseLocalDocumentManagement Condition="'$(UseLocalDocumentManagement)' == 'true' and !Exists('$(LocalDocumentManagementProject)')">false</UseLocalDocumentManagement>
    <UseLocalEventing Condition="'$(UseLocalEventing)' == 'true' and !(Exists('$(LocalEventingProject)') and Exists('$(LocalEventingHttpProject)') and Exists('$(LocalEventingAzureServiceBusProject)'))">false</UseLocalEventing>
    <UseLocalLogging Condition="'$(UseLocalLogging)' == 'true' and !Exists('$(LocalLoggingProject)')">false</UseLocalLogging>
    <UseLocalMail Condition="'$(UseLocalMail)' == 'true' and !Exists('$(LocalMailProject)')">false</UseLocalMail>
    <UseLocalPackaging Condition="'$(UseLocalPackaging)' == 'true' and !Exists('$(LocalPackagingProject)')">false</UseLocalPackaging>
    <UseLocalSecurity Condition="'$(UseLocalSecurity)' == 'true' and !(Exists('$(LocalSecurityProject)') and Exists('$(LocalSecurityDataProject)'))">false</UseLocalSecurity>
    <UseLocalWorkflow Condition="'$(UseLocalWorkflow)' == 'true' and !(Exists('$(LocalWorkflowProject)') and Exists('$(LocalWorkflowActivitiesProject)') and Exists('$(LocalWorkflowEngineProject)'))">false</UseLocalWorkflow>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="..\cCoder.Core.FrontEnd\cCoder.Core.FrontEnd.esproj"
      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalAppSecurity)' == 'true'">
    <ProjectReference Include="$(LocalAppSecurityProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalSecurity=$(UseLocalSecurity);UseLocalEventing=$(UseLocalEventing)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalAI)' == 'true'">
    <ProjectReference Include="$(LocalAIProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalData)' == 'true'">
    <ProjectReference Include="$(LocalDataProject)" AdditionalProperties="UseLocalSecurityData=$(UseLocalSecurity);UseLocalEventing=$(UseLocalEventing)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalContentManagement)' == 'true'">
    <ProjectReference Include="$(LocalContentManagementProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalEventing=$(UseLocalEventing)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDocumentManagement)' == 'true'">
    <ProjectReference Include="$(LocalDocumentManagementProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalEventing=$(UseLocalEventing)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalEventing)' == 'true'">
    <ProjectReference Include="$(LocalEventingProject)" />
    <ProjectReference Include="$(LocalEventingHttpProject)" />
    <ProjectReference Include="$(LocalEventingAzureServiceBusProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalLogging)' == 'true'">
    <ProjectReference Include="$(LocalLoggingProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalEventing=$(UseLocalEventing)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalMail)' == 'true'">
    <ProjectReference Include="$(LocalMailProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalEventing=$(UseLocalEventing)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalPackaging)' == 'true'">
    <ProjectReference Include="$(LocalPackagingProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalEventing=$(UseLocalEventing)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSecurity)' == 'true'">
    <ProjectReference Include="$(LocalSecurityProject)" AdditionalProperties="UseLocalEventing=$(UseLocalEventing)" />
    <ProjectReference Include="$(LocalSecurityDataProject)" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalWorkflow)' == 'true'">
    <ProjectReference Include="$(LocalWorkflowProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalSecurity=$(UseLocalSecurity);UseLocalEventing=$(UseLocalEventing)" />
    <ProjectReference Include="$(LocalWorkflowActivitiesProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalSecurity=$(UseLocalSecurity)" />
    <ProjectReference Include="$(LocalWorkflowEngineProject)" AdditionalProperties="UseLocalData=$(UseLocalData);UseLocalSecurity=$(UseLocalSecurity)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="cCoder.AI" Version="2026.8.3.1800" Condition="'$(UseLocalAI)' != 'true'" />
    <PackageReference Include="cCoder.AppSecurity" Version="2026.8.4.1522" Condition="'$(UseLocalAppSecurity)' != 'true'" />
    <PackageReference Include="cCoder.ContentManagement" Version="2026.8.4.10" Condition="'$(UseLocalContentManagement)' != 'true'" />
    <PackageReference Include="cCoder.Data" Version="2026.8.3.2349" Condition="'$(UseLocalData)' != 'true'" />
    <PackageReference Include="cCoder.DocumentManagement" Version="2026.8.4.3" Condition="'$(UseLocalDocumentManagement)' != 'true'" />
    <PackageReference Include="cCoder.Eventing" Version="2026.8.3.1758" Condition="'$(UseLocalEventing)' != 'true'" />
    <PackageReference Include="cCoder.Eventing.AzureServiceBus" Version="2026.8.3.1758" Condition="'$(UseLocalEventing)' != 'true'" />
    <PackageReference Include="cCoder.Eventing.Http" Version="2026.8.3.1758" Condition="'$(UseLocalEventing)' != 'true'" />
    <PackageReference Include="cCoder.Logging" Version="2026.8.4.1030" Condition="'$(UseLocalLogging)' != 'true'" />
    <PackageReference Include="cCoder.Mail" Version="2026.8.4.14" Condition="'$(UseLocalMail)' != 'true'" />
    <PackageReference Include="cCoder.Packaging" Version="2026.8.4.0" Condition="'$(UseLocalPackaging)' != 'true'" />
    <PackageReference Include="cCoder.Security" Version="2026.8.3.2228" Condition="'$(UseLocalSecurity)' != 'true'" />
    <PackageReference Include="cCoder.Security.Data" Version="2026.8.3.2228" Condition="'$(UseLocalSecurity)' != 'true'" />
    <PackageReference Include="cCoder.Workflow" Version="2026.8.4.1024" Condition="'$(UseLocalWorkflow)' != 'true'" />
    <PackageReference Include="cCoder.Workflow.Activities" Version="2026.8.4.1024" Condition="'$(UseLocalWorkflow)' != 'true'" />
    <PackageReference Include="cCoder.Workflow.Engine" Version="2026.8.4.1024" Condition="'$(UseLocalWorkflow)' != 'true'" />
    <PackageReference Include="Microsoft.AspNetCore.OData" Version="9.5.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.3" />
    <PackageReference Include="itext" Version="9.7.0" />
    <PackageReference Include="itext.pdfhtml" Version="6.3.3" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.7.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>
  <Target
    Name="CopyFrontEndAssets"
    AfterTargets="ResolveProjectReferences"
    BeforeTargets="DefineStaticWebAssets">
    <ItemGroup>
      <FrontEndAsset Include="..\cCoder.Core.FrontEnd\stage\**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(FrontEndAsset)"
      DestinationFiles="@(FrontEndAsset->'wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
