@model cCoder.Core.Models.FirstTimeSetupViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>cCoder.Core setup</title>
    <style>
        :root {
            color-scheme: light;
            --bg: #f3f9fc;
            --panel: #ffffff;
            --ink: #142a48;
            --muted: #52657a;
            --accent: #142a48;
            --accent-hover: #1f426e;
            --code: #45b9e8;
            --border: #cfdee8;
            --danger: #b42318;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Quicksand, "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1.5rem;
        }

        .shell {
            width: min(100%, 76rem);
            display: grid;
            grid-template-columns: minmax(20rem, 0.78fr) minmax(36rem, 1.22fr);
            background: var(--panel);
            border: 1px solid var(--border);
            border-top: 4px solid var(--code);
            overflow: hidden;
            box-shadow: 0 1.25rem 3.5rem rgba(20, 42, 72, 0.13);
        }

        .intro,
        .form-panel {
            padding: 2.5rem;
        }

        .intro {
            background:
                linear-gradient(145deg, rgba(20, 42, 72, 0.99), rgba(24, 58, 94, 0.96)),
                var(--accent);
            color: #ffffff;
            display: flex;
            flex-direction: column;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 2.5rem;
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: 0.02em;
        }

        .brand-mark {
            color: var(--code);
            font: 700 1.65rem/1 Consolas, "Courier New", monospace;
        }

        .brand small {
            display: block;
            margin-top: 0.15rem;
            color: #a9c6d8;
            font-size: 0.62rem;
            font-weight: 500;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0 0 1rem;
            font-size: clamp(1.85rem, 2.6vw, 2.15rem);
            font-weight: 400;
            line-height: 1.12;
            white-space: nowrap;
        }

        .lead {
            font-size: 1.05rem;
            line-height: 1.65;
            max-width: 28rem;
            opacity: 0.92;
        }

        .facts {
            margin: 2rem 0 0;
            padding: 0 0 0 2.75rem;
            list-style: disc;
            display: grid;
            gap: 0.9rem;
            position: relative;
        }

        .facts li {
            color: #dceaf2;
            line-height: 1.45;
        }

        .facts::before,
        .facts::after {
            position: absolute;
            left: 0;
            color: var(--code);
            font: 700 1rem/1 Consolas, "Courier New", monospace;
        }

        .facts::before {
            top: -1.6rem;
            content: "{";
        }

        .facts::after {
            bottom: -1.8rem;
            content: "}";
        }

        .setup-guide {
            align-self: flex-start;
            margin-top: auto;
            padding-top: 3.5rem;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 600;
            text-decoration-color: var(--code);
            text-underline-offset: 0.25rem;
        }

        .setup-guide:hover,
        .setup-guide:focus-visible {
            color: #ffffff;
            text-decoration-color: var(--code);
        }

        .form-panel h2 {
            margin: 0 0 0.75rem;
            font-size: 1.8rem;
            font-weight: 600;
        }

        .subtle {
            color: var(--muted);
            line-height: 1.55;
            margin-bottom: 1.5rem;
        }

        .domain {
            margin: 0 0 1.5rem;
            padding: 0.85rem 1rem;
            background: var(--bg);
            border: 1px solid var(--border);
            border-left: 4px solid var(--code);
            font-size: 0.95rem;
        }

        form {
            display: grid;
            gap: 0.9rem;
        }

        .class-editor {
            padding: 0.85rem 1.1rem 0.95rem;
            border: 1px solid var(--border);
            border-left: 4px solid var(--accent);
            background: #f8fbfd;
            box-shadow: inset 0 1px 0 #ffffff;
            font-family: Consolas, "Courier New", monospace;
        }

        .method-declaration,
        .class-brace {
            font-size: 0.92rem;
            line-height: 1.5;
        }

        .class-brace {
            color: var(--code);
            font-weight: 700;
        }

        .method-body {
            display: grid;
            gap: 0.5rem;
            padding: 0.5rem 0 0.5rem 1.25rem;
            border-left: 1px solid rgba(69, 185, 232, 0.3);
        }

        .initializer {
            display: grid;
            gap: 0.45rem;
            padding-left: 1.25rem;
        }

        .keyword {
            color: #285bc5;
        }

        .type {
            color: #168273;
        }

        .accessor {
            color: #7b4ba8;
        }

        .operator {
            color: var(--muted);
        }

        .field-row {
            display: grid;
            grid-template-columns: 8.5rem minmax(0, 1fr);
            align-items: center;
            gap: 0.45rem 1rem;
        }

        label {
            color: var(--ink);
            font-size: 0.82rem;
            font-weight: 400;
            text-align: left;
            white-space: nowrap;
        }

        input {
            width: 100%;
            min-width: 0;
            padding: 0.65rem 0.9rem;
            border: 1px solid #b9cad6;
            border-radius: 2px;
            background: #ffffff;
            color: var(--ink);
            font: inherit;
        }

        input:focus {
            outline: 3px solid rgba(69, 185, 232, 0.18);
            border-color: var(--code);
        }

        .validation-summary-errors,
        .field-validation-error {
            color: var(--danger);
            font-size: 0.9rem;
        }

        .field-row .field-validation-error {
            grid-column: 2;
        }

        .validation-summary-errors ul {
            margin: 0 0 0.25rem 1rem;
            padding: 0;
        }

        button {
            justify-self: end;
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;
            margin-top: 0.65rem;
            padding: 0.8rem 1.25rem;
            border: 0;
            border-radius: 2px;
            background: var(--accent);
            color: white;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }

        .compile-icon {
            color: var(--code);
            font: 700 0.95rem/1 Consolas, "Courier New", monospace;
        }

        button:hover {
            background: var(--accent-hover);
        }

        button:disabled {
            cursor: wait;
            opacity: 0.65;
        }

        dialog {
            width: min(90vw, 46rem);
            border: 1px solid var(--border);
            padding: 0;
            color: var(--ink);
            background: var(--panel);
        }

        dialog::backdrop {
            background: rgba(15, 23, 42, 0.62);
        }

        .setup-progress {
            padding: 1.5rem;
        }

        .setup-progress h2 {
            margin-top: 0;
        }

        .setup-log {
            /* Fifteen success messages at a 1.44rem line height, plus vertical padding. */
            height: 23.6rem;
            overflow: auto;
            margin: 1rem 0 0;
            padding: 1rem;
            background: #111827;
            color: #d1fae5;
            font: 0.9rem/1.6 Consolas, "Courier New", monospace;
            white-space: pre-wrap;
        }

        @@media (max-width: 900px) {
            .shell {
                grid-template-columns: 1fr;
            }

            h1 {
                white-space: normal;
            }

            .intro,
            .form-panel {
                padding: 2rem 1.4rem;
            }
        }

        @@media (max-width: 620px) {
            body {
                padding: 0;
            }

            .field-row {
                grid-template-columns: 1fr;
                gap: 0.35rem;
            }

            label {
                text-align: left;
                white-space: normal;
            }

            .field-row .field-validation-error {
                grid-column: 1;
            }

            .method-body,
            .initializer {
                padding-left: 0.75rem;
            }

            button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <main class="shell">
        <section class="intro">
            <div class="brand">
                <span class="brand-mark">&lt;/&gt;</span>
                <span>cCoder <small>Connected. Committed. Capable.</small></span>
            </div>
            <p class="lead">
                This first-run only flow will:
            </p>
            <ul class="facts">
                <li>Create the initial tenant.</li>
                <li>Provision the baseline application.</li>
                <li>Import the packaged starter content.</li>
                <li>Register the first administrator account.</li>
                <li>Assign the detected primary domain to the first app automatically.</li>
                <li>Include the starter pages, layouts, templates, scripts, and resources in the imported baseline.</li>
            </ul>
            <a class="setup-guide"
               href="https://ccoder.co.uk/Documentation/Core/FirstTimeSetup"
               target="_blank"
               rel="noopener noreferrer">Read the first-time setup guide →</a>
        </section>

        <section class="form-panel">
            <h1>Welcome to cCoder.Core platform setup</h1>
            <p class="subtle">
                Enter the minimum details required to bootstrap the platform. You can refine the tenant and app
                configuration from the admin UI after setup completes.
            </p>

            @Html.ValidationSummary(false)

            <form id="setup-form">
                <div class="class-editor">
                    <div class="method-declaration">
                        <span class="keyword">void</span> PlatformSetup()
                    </div>
                    <div class="class-brace">{</div>
                    <div class="method-body">
                        <div>
                            <span class="keyword">var</span> details <span class="operator">=</span>
                            <span class="keyword">new</span> <span class="type">FirstAdminUserDetails</span>()
                        </div>
                        <div class="class-brace">{</div>
                        <div class="initializer">
                            <div class="field-row">
                                <label asp-for="Setup.DisplayName">DisplayName <span class="operator">=</span></label>
                                <input asp-for="Setup.DisplayName" aria-label="Display name" autocomplete="name" required />
                                <span asp-validation-for="Setup.DisplayName"></span>
                            </div>

                            <div class="field-row">
                                <label asp-for="Setup.Email">Email <span class="operator">=</span></label>
                                <input asp-for="Setup.Email" aria-label="Email address" autocomplete="email" type="email" required />
                                <span asp-validation-for="Setup.Email"></span>
                            </div>

                            <div class="field-row">
                                <label asp-for="Setup.Password">Password <span class="operator">=</span></label>
                                <input asp-for="Setup.Password" aria-label="Password" autocomplete="new-password" type="password" required />
                                <span asp-validation-for="Setup.Password"></span>
                            </div>

                            <div class="field-row">
                                <label asp-for="Setup.ConfirmPassword">ConfirmPassword <span class="operator">=</span></label>
                                <input asp-for="Setup.ConfirmPassword" aria-label="Confirm password" autocomplete="new-password" type="password" required />
                                <span asp-validation-for="Setup.ConfirmPassword"></span>
                            </div>
                        </div>
                        <div class="class-brace">};</div>

                        <button id="setup-button" type="submit">
                            <span class="compile-icon" aria-hidden="true">&#9654;</span>
                            Submit(details);
                        </button>
                    </div>
                    <div class="class-brace">}</div>
                </div>
            </form>
        </section>
    </main>

    <dialog id="setup-dialog">
        <section class="setup-progress">
            <h2>Setting up your platform</h2>
            <p>Please keep this window open while the initial environment is prepared.</p>
            <pre id="setup-log" class="setup-log" aria-live="polite"></pre>
        </section>
    </dialog>

    <script>
        (() => {
            const form = document.getElementById("setup-form");
            const button = document.getElementById("setup-button");
            const dialog = document.getElementById("setup-dialog");
            const log = document.getElementById("setup-log");
            const domain = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Domain));
            const assetsRoot =
                "https://raw.githubusercontent.com/ccoder-co-uk/cCoder.Assets/main/" +
                "Packages/First%20Time%20Setup/";
            const defaultAppConfig = {
                Themes: {
                    Default: {
                        margins: "8px",
                        colours: {
                            primary: "#142A48",
                            secondary: "#52BCFF",
                            background: "white",
                            text: "black",
                            text2: "#FFFFFF",
                        },
                        font: {
                            size: "14px",
                            family: "Quicksand, sans-serif",
                        },
                        border: {
                            style: "solid 1px #CCC",
                            width: "1px",
                            radius: 0,
                        },
                        shadows: "6px 6px 10px #ccc",
                    },
                },
            };

            const appendLog = (message) => {
                const timestamp = new Date().toLocaleTimeString();
                log.textContent += `[${timestamp}] ${message}\n`;
                log.scrollTop = log.scrollHeight;
            };

            const delay = (milliseconds) =>
                new Promise((resolve) => window.setTimeout(resolve, milliseconds));

            const readError = async (response) => {
                const message = await response.text();

                return message || `${response.status} ${response.statusText}`;
            };

            const sendJson = async (url, body) => {
                const response = await fetch(url, {
                    method: "POST",
                    credentials: "same-origin",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(body),
                });

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                const contentType = response.headers.get("content-type") || "";

                return contentType.includes("application/json")
                    ? response.json()
                    : null;
            };

            const getJson = async (url) => {
                const response = await fetch(url, {
                    credentials: "same-origin",
                });

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                const contentType = response.headers.get("content-type") || "";

                return contentType.includes("application/json")
                    ? response.json()
                    : null;
            };

            const downloadPackage = async (name) => {
                appendLog(`Downloading ${name}...`);
                const response = await fetch(`${assetsRoot}${name}.json`);

                if (!response.ok) {
                    throw new Error(await readError(response));
                }

                appendLog(`Downloaded ${name}.`);

                return response.json();
            };

            const toCommonObjects = (setupPackage) => ({
                value: setupPackage.Items.flatMap((item) => {
                    const data = JSON.parse(item.Data);
                    const records = Array.isArray(data) ? data : [data];

                    return records.map((record) => ({
                        Name: record.Name,
                        Description: record.Description ?? null,
                        Version: 1,
                        Key: record.ResourceKey
                            ?? record.Key
                            ?? setupPackage.Category,
                        Type: item.Type,
                        Json: JSON.stringify(record),
                        Culture: record.Culture ?? "",
                    }));
                }),
            });

            form.addEventListener("submit", async (event) => {
                event.preventDefault();

                if (!form.reportValidity()) {
                    return;
                }

                const tenantName = "cCoder Default";

                const displayName =
                    document.getElementById("Setup_DisplayName").value.trim();

                const email =
                    document.getElementById("Setup_Email").value.trim();

                const password =
                    document.getElementById("Setup_Password").value;

                const confirmation =
                    document.getElementById("Setup_ConfirmPassword").value;

                if (password !== confirmation) {
                    window.alert("The password confirmation does not match.");

                    return;
                }

                button.disabled = true;
                dialog.showModal();
                appendLog("Starting first-time setup.");

                try {
                    appendLog("Creating the Default tenant and administrator.");

                    await sendJson("/Api/Setup", {
                        Tenant: {
                            Id: "default",
                            Name: tenantName,
                        },
                        User: {
                            DisplayName: displayName,
                            Email: email,
                            PasswordHash: password,
                            PhoneNumber: "",
                        },
                    });

                    appendLog("Security bootstrap completed.");
                    appendLog("Signing in the initial administrator.");

                    await sendJson("/Api/Account/Login", {
                        User: email.split("\x40")[0],
                        Pass: password,
                    });

                    appendLog("Administrator signed in.");
                    appendLog("Creating the first application.");

                    const app = await sendJson("/Api/ContentManagement/App", {
                        Name: tenantName,
                        Domain: domain,
                        DefaultTheme: "Default",
                        DefaultCultureId: "",
                        TenantId: "default",
                        ConfigJson: JSON.stringify(defaultAppConfig),
                    });

                    const appId = app.Id ?? app.id;
                    appendLog(`Application created with ID ${appId}.`);

                    const [commonCachePackage, appBaselinePackage] =
                        await Promise.all([
                            downloadPackage("common-cache"),
                            downloadPackage("app-baseline"),
                        ]);

                    appendLog("Importing common cache and application baselines.");

                    await Promise.all([
                        sendJson(
                            "/Api/ContentManagement/CommonObject/Import",
                            toCommonObjects(commonCachePackage)),
                        sendJson(
                            `/Api/Core/Package/Import?appId=${appId}`,
                            appBaselinePackage),
                    ]);

                    appendLog("Baseline imports completed.");
                    appendLog("Activating the common cache.");
                    await getJson("/Api/RefreshCache");
                    appendLog("Setup complete.");
                    appendLog("Redirecting to configured site ...");
                    await delay(3000);
                    window.location.assign("/");
                } catch (error) {
                    appendLog(`ERROR: ${error.message}`);
                    appendLog("Setup stopped. Review the error before retrying.");
                    button.disabled = false;
                }
            });
        })();
    </script>
</body>
</html>
