# Run Initialize.ps1 to create .env with locally generated development secrets.
# Do not put production credentials in this file.
CCODER_SQL_PASSWORD=replace-with-a-generated-development-password
CCODER_DECRYPTION_KEY=replace-with-a-generated-48-character-key
CCODER_SQL_PORT=1433
CCODER_WEB_PORT=5099
CCODER_HOSTED_SERVICES_PORT=5100
CCODER_WORKFLOW_PORT=7071
