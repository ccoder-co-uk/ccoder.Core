# Copy this file to .env, then provide endpoints reachable from containers.
# For SQL exposed on the Docker host, use Server=host.docker.internal,1433.
CCODER_CORE_CONNECTION_STRING=
CCODER_SECURITY_CONNECTION_STRING=

# Initialize.ps1 generates these local-only values.
CCODER_DECRYPTION_KEY=

CCODER_WEB_HTTP_PORT=80
CCODER_WEB_HTTPS_PORT=443
CCODER_WORKFLOW_HTTP_PORT=800
CCODER_WORKFLOW_HTTPS_PORT=4433
